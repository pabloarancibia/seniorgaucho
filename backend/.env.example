# SQLite: la ruta es relativa a prisma.config.ts (raíz de backend/), no a prisma/schema.prisma
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN="http://localhost:3000"

# --- LLM (chat de práctica con IA) ---
# Proveedor por default si una sesión no especifica uno: anthropic | google | fake
# "fake" no necesita ninguna API key — respuestas guionadas, útil para desarrollar
# sin gastar tokens.
LLM_PROVIDER="fake"
LLM_EFFORT="medium"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-opus-5"

GOOGLE_API_KEY=
GEMINI_MODEL="gemini-3-flash-preview"
